          <mxGeometry height="50" width="465" x="230" y="540" as="geometry" />
        </mxCell>
        <mxCell id="p3-r5c2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;" value="重算 = 新池内总量（池内用量已清零）" vertex="1">
          <mxGeometry height="50" width="465" x="695" y="540" as="geometry" />
        </mxCell>
        <mxCell id="p3-r6c0" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" value="待出池卡（上月申请）" vertex="1">
          <mxGeometry height="60" width="190" x="40" y="590" as="geometry" />
        </mxCell>
        <mxCell id="p3-r6c12" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;" value="两种池相同：次月 1 日 0 点、上月账单结完后生效出池，移出池卡列表并减少卡数；出池前（待出池期间）用量仍计入本池、仍参与超池与池外；出池后改回按原基础套餐结算。" vertex="1">
          <mxGeometry height="60" width="930" x="230" y="590" as="geometry" />
        </mxCell>
        <mxCell id="p3-renew" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;预购池续订新周期生效时（非跨月触发，顺序固定）：&lt;/b&gt;① 旧周期（池内总量 / 池内用量 / 合约时长 / 池生效·到期时间 / 实际失效时间）写入「历史流量池」 → ② 池内总量&lt;b&gt;覆盖&lt;/b&gt;为续订容量（不叠加），池内用量&lt;b&gt;清零&lt;/b&gt; → ③ 当月剩余池内用量重算 = 续订容量 → ④ 当月超池 / 池外用量先计入当月账单再清零 → ⑤ 因达量 suspend、因池到期 expired 的卡恢复 active（cancel 不恢复）。" vertex="1">
          <mxGeometry height="90" width="1120" x="40" y="680" as="geometry" />
