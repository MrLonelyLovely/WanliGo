<mxfile host="Electron" agent="draw.io" pages="3">
  <diagram id="page-fields" name="1 池级字段口径对照">
    <mxGraphModel dx="1088" dy="702" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1-title" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" value="池级字段口径对照（预购流量池 vs 共享流量池）" vertex="1">
          <mxGeometry height="40" width="700" x="40" y="30" as="geometry" />
        </mxCell>
        <mxCell id="t1-h0" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" value="字段" vertex="1">
          <mxGeometry height="40" width="170" x="40" y="90" as="geometry" />
        </mxCell>
        <mxCell id="t1-h1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" value="预购流量池" vertex="1">
          <mxGeometry height="40" width="400" x="210" y="90" as="geometry" />
        </mxCell>
        <mxCell id="t1-h2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" value="共享流量池" vertex="1">
          <mxGeometry height="40" width="400" x="610" y="90" as="geometry" />
        </mxCell>
        <mxCell id="t1-r1c0" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" value="池内总量" vertex="1">
          <mxGeometry height="110" width="170" x="40" y="130" as="geometry" />
        </mxCell>
        <mxCell id="t1-r1c1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;" value="建池时锁定的容量&lt;br&gt;&lt;b&gt;跨月不变&lt;/b&gt;；中途入池&lt;b&gt;不变&lt;/b&gt;&lt;br&gt;仅「续订」生效时&lt;b&gt;覆盖&lt;/b&gt;为续订容量（不叠加）" vertex="1">
          <mxGeometry height="110" width="400" x="210" y="130" as="geometry" />
        </mxCell>
        <mxCell id="t1-r1c2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;" value="= 计容卡数 × 单卡套餐额度，动态刷新：&lt;br&gt;① 月初1号0点：&lt;b&gt;重置&lt;/b&gt; = active数 × 单卡额度&lt;br&gt;② 每日0:30：= (active+suspend)数 × 单卡额度，&lt;b&gt;只增不减&lt;/b&gt;&lt;br&gt;③ 卡入池：+= 新入池 active 卡数 × 单卡额度（active test 不增加）" vertex="1">
          <mxGeometry height="110" width="400" x="610" y="130" as="geometry" />
        </mxCell>
        <mxCell id="t1-r2c0" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" value="池内用量" vertex="1">
          <mxGeometry height="100" width="170" x="40" y="240" as="geometry" />
        </mxCell>
        <mxCell id="t1-r2c1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;" value="Σ(池内卡在&lt;b&gt;池目标区域&lt;/b&gt;内的用量)&lt;br&gt;&lt;b&gt;合约期内累计，跨月不清零&lt;/b&gt;&lt;br&gt;超量开关开启时允许 &amp;gt; 池内总量&lt;br&gt;续订新周期生效时清零" vertex="1">
          <mxGeometry height="100" width="400" x="210" y="240" as="geometry" />
        </mxCell>
        <mxCell id="t1-r2c2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;" value="Σ(池内卡在池目标区域内的用量)&lt;br&gt;（共享池目标区域 = 关联套餐区域，与卡套餐一致）&lt;br&gt;&lt;b&gt;跨月清零&lt;/b&gt;" vertex="1">
          <mxGeometry height="100" width="400" x="610" y="240" as="geometry" />
        </mxCell>
        <mxCell id="t1-r3c0" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" value="当月超池用量" vertex="1">
          <mxGeometry height="90" width="170" x="40" y="340" as="geometry" />
        </mxCell>
        <mxCell id="t1-r3c12" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;两种池口径相同：&lt;br&gt;&lt;/b&gt;超量开关&lt;b&gt;开启&lt;/b&gt;，且池内用量已超过池内总量之后，继续产生的&lt;b&gt;区域内&lt;/b&gt;用量计入；未超过部分不计入。按超池价格计费。&lt;b&gt;跨月清零&lt;/b&gt;（先计入当月账单再清零）。&lt;br&gt;开关&lt;b&gt;关闭&lt;/b&gt;：达量后池内 active / active test 自动停机 → suspend，&lt;b&gt;不产生&lt;/b&gt;超池用量。" vertex="1">
          <mxGeometry height="90" width="800" x="210" y="340" as="geometry" />
        </mxCell>
        <mxCell id="t1-r4c0" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" value="当月池外用量" vertex="1">
          <mxGeometry height="70" width="170" x="40" y="430" as="geometry" />
        </mxCell>
        <mxCell id="t1-r4c12" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;" value="&lt;b&gt;两种池口径相同：&lt;/b&gt;Σ(池内卡当月在&lt;b&gt;池目标区域外&lt;/b&gt;的用量)。不占池容量，按池外价格计费。&lt;b&gt;跨月清零&lt;/b&gt;（先计入当月账单再清零）。" vertex="1">
          <mxGeometry height="70" width="800" x="210" y="430" as="geometry" />
        </mxCell>
        <mxCell id="t1-r5c0" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" value="当月剩余池内用量" vertex="1">
          <mxGeometry height="70" width="170" x="40" y="500" as="geometry" />
        </mxCell>
        <mxCell id="t1-r5c12" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;" value="&lt;b&gt;两种池口径相同：&lt;/b&gt;= max(0, 池内总量 − 池内用量)，不能为负。&lt;b&gt;跨月重算&lt;/b&gt;（随池内总量 / 池内用量任一刷新而同步重算）。" vertex="1">
          <mxGeometry height="70" width="800" x="210" y="500" as="geometry" />
        </mxCell>
        <mxCell id="t1-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;区域判定统一口径：&lt;/b&gt;入池后一切以「池目标区域」为准。预购池 = 建池绑定 Roaming 的目标区域（可能 ≠ 卡原套餐区域，入池需重算，见第 2 页）；共享池 = 关联套餐的目标区域（与卡套餐完全一致，无需重算）。" vertex="1">
          <mxGeometry height="60" width="970" x="40" y="590" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-midjoin" name="2 卡片中途入池">
    <mxGraphModel grid="0" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1169" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2-title" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" value="卡片中途入池：字段刷新流程（入池前该卡当月已产生用量）" vertex="1">
          <mxGeometry height="40" width="760" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="p2-start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="卡片中途入池成功&lt;br&gt;（入池前当月已产生用量：&lt;br&gt;单卡套餐内 + 单卡套餐外）" vertex="1">
          <mxGeometry height="70" width="240" x="440" y="70" as="geometry" />
        </mxCell>
        <mxCell id="p2-dec" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="池类型？" vertex="1">
          <mxGeometry height="70" width="140" x="490" y="180" as="geometry" />
        </mxCell>
        <mxCell id="p2-e1" edge="1" parent="1" source="p2-start" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" target="p2-dec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-pre1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;① 池内总量：不变&lt;/b&gt;&lt;br&gt;（建池锁定，入池不扩容）" vertex="1">
          <mxGeometry height="60" width="340" x="100" y="300" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-pre" edge="1" parent="1" source="p2-dec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;" target="p2-pre1" value="预购流量池">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-pre2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;② 将入池前用量按「池目标区域」逐条重判&lt;/b&gt;&lt;br&gt;入池前按卡口径记账：&lt;b&gt;单卡套餐内用量 = A + B&lt;/b&gt;，&lt;b&gt;单卡套餐外用量 = C + D&lt;/b&gt;&lt;br&gt;池目标区域可能 ≠ 卡原套餐区域，不能整块搬运，&lt;br&gt;须按每条用量发生时的 MCC ∈/∉ 池目标区域重新归类（见下方矩阵）" vertex="1">
          <mxGeometry height="100" width="340" x="100" y="390" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-pre2" edge="1" parent="1" source="p2-pre1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" target="p2-pre2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-pre3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;③ 池内用量 += A + C&lt;/b&gt;&lt;br&gt;（A：原套餐内保持区域内；C：原套餐外&lt;b&gt;改判&lt;/b&gt;区域内）&lt;br&gt;&lt;b&gt;当月池外用量 += B + D&lt;/b&gt;&lt;br&gt;（B：原套餐内&lt;b&gt;改判&lt;/b&gt;区域外；D：原套餐外保持区域外）" vertex="1">
          <mxGeometry height="90" width="340" x="100" y="520" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-pre3" edge="1" parent="1" source="p2-pre2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" target="p2-pre3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-pre4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;④ 超池判定与剩余重算&lt;/b&gt;&lt;br&gt;若并入后 池内用量 &amp;gt; 池内总量：&lt;br&gt;· 超量开关&lt;b&gt;开&lt;/b&gt;：超出部分计入&lt;b&gt;当月超池用量&lt;/b&gt;（按超池价格）&lt;br&gt;· 超量开关&lt;b&gt;关&lt;/b&gt;：不产生超池用量，池内 active / active test 停机 → suspend&lt;br&gt;&lt;b&gt;当月剩余池内用量&lt;/b&gt; = max(0, 池内总量 − 池内用量)" vertex="1">
          <mxGeometry height="110" width="340" x="100" y="640" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-pre4" edge="1" parent="1" source="p2-pre3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" target="p2-pre4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-sh1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="卡状态？" vertex="1">
          <mxGeometry height="70" width="140" x="740" y="295" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-sh" edge="1" parent="1" source="p2-dec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;" target="p2-sh1" value="共享流量池">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-sh2a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;① 池内总量&lt;br&gt;+= active 卡数 × 单卡额度&lt;/b&gt;" vertex="1">
          <mxGeometry height="60" width="200" x="620" y="400" as="geometry" />
        </mxCell>
        <mxCell id="p2-sh2b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;① 池内总量：不变&lt;/b&gt;&lt;br&gt;（active test 不增加容量）" vertex="1">
          <mxGeometry height="60" width="200" x="860" y="400" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-sh2a" edge="1" parent="1" source="p2-sh1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" target="p2-sh2a" value="active">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-sh2b" edge="1" parent="1" source="p2-sh1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" target="p2-sh2b" value="active test">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-sh3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;② 池内用量 += Σ(新入池卡当月套餐内已用量)&lt;/b&gt;&lt;br&gt;共享池目标区域 = 卡套餐区域，口径一致，&lt;b&gt;无需重算&lt;/b&gt;&lt;br&gt;原「套餐内用量」直接并入池内用量；&lt;br&gt;原「套餐外用量」直接并入当月池外用量" vertex="1">
          <mxGeometry height="90" width="340" x="670" y="500" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-sh3a" edge="1" parent="1" source="p2-sh2a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" target="p2-sh3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-sh3b" edge="1" parent="1" source="p2-sh2b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" target="p2-sh3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-sh4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;③ 当月剩余池内用量&lt;/b&gt;&lt;br&gt;= max(0, 池内总量 − 池内用量)" vertex="1">
          <mxGeometry height="70" width="340" x="670" y="620" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-sh4" edge="1" parent="1" source="p2-sh3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" target="p2-sh4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-end" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;费用口径（两种池相同）&lt;/b&gt;&lt;br&gt;入池当月及之后：不再走单卡套餐月结，只出流量池账单；预购池不收池内卡「月租费」「套餐费用」。&lt;br&gt;入池前已按单卡结算的历史月份费用：&lt;b&gt;不回滚&lt;/b&gt;，仅当月用量按上述规则并池，不重复计费。&lt;br&gt;出池（次月1日生效）后：改回按该卡原基础套餐结算；池内已计过的用量不再按原套餐收一次。" vertex="1">
          <mxGeometry height="100" width="910" x="100" y="780" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-end1" edge="1" parent="1" source="p2-pre4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" target="p2-end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-end2" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="p2-end">
          <mxGeometry relative="1" x="0.0053" as="geometry">
            <Array as="points">
              <mxPoint x="840" y="765" />
              <mxPoint x="555" y="765" />
            </Array>
            <mxPoint x="840" y="691" as="sourcePoint" />
            <mxPoint x="555" y="781" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-m-title" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" value="预购池 · 入池前当月用量的重算矩阵（示例：卡原套餐区域 = {a, b}，池目标区域 = {a, c}）" vertex="1">
          <mxGeometry height="30" width="910" x="100" y="910" as="geometry" />
        </mxCell>
        <mxCell id="p2-m-c00" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" value="用量发生时的 MCC" vertex="1">
          <mxGeometry height="40" width="190" x="100" y="950" as="geometry" />
        </mxCell>
        <mxCell id="p2-m-ch1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="∈ 池目标区域（a、c）&lt;br&gt;→ 入池后判「区域内」" vertex="1">
          <mxGeometry height="40" width="360" x="290" y="950" as="geometry" />
        </mxCell>
        <mxCell id="p2-m-ch2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="∉ 池目标区域&lt;br&gt;→ 入池后判「区域外」" vertex="1">
          <mxGeometry height="40" width="360" x="650" y="950" as="geometry" />
        </mxCell>
        <mxCell id="p2-m-rh1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="∈ 卡原套餐区域（a、b）&lt;br&gt;入池前记&lt;b&gt;「单卡套餐内用量」&lt;/b&gt;&lt;br&gt;= A + B" vertex="1">
          <mxGeometry height="70" width="190" x="100" y="990" as="geometry" />
        </mxCell>
        <mxCell id="p2-m-A" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;A&lt;/b&gt;（如 a）：卡区域 ✔，池区域 ✔&lt;br&gt;区域内 → 仍区域内，并入&lt;b&gt;池内用量&lt;/b&gt;" vertex="1">
          <mxGeometry height="70" width="360" x="290" y="990" as="geometry" />
        </mxCell>
        <mxCell id="p2-m-B" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;B&lt;/b&gt;（如 b）：卡区域 ✔，池区域 ❌&lt;br&gt;原算区域内 → &lt;b&gt;改判区域外&lt;/b&gt;，并入&lt;b&gt;当月池外用量&lt;/b&gt;" vertex="1">
          <mxGeometry height="70" width="360" x="650" y="990" as="geometry" />
        </mxCell>
        <mxCell id="p2-m-rh2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="∉ 卡原套餐区域&lt;br&gt;入池前记&lt;b&gt;「单卡套餐外用量」&lt;/b&gt;&lt;br&gt;= C + D" vertex="1">
          <mxGeometry height="70" width="190" x="100" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="p2-m-C" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;C&lt;/b&gt;（如 c）：卡区域 ❌，池区域 ✔&lt;br&gt;原算区域外 → &lt;b&gt;改判区域内&lt;/b&gt;，并入&lt;b&gt;池内用量&lt;/b&gt;（占池容量）" vertex="1">
          <mxGeometry height="70" width="360" x="290" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="p2-m-D" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;D&lt;/b&gt;（如 d）：卡区域 ❌，池区域 ❌&lt;br&gt;区域外 → 仍区域外，并入&lt;b&gt;当月池外用量&lt;/b&gt;" vertex="1">
          <mxGeometry height="70" width="360" x="650" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="p2-m-sum" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;结论：&lt;/b&gt;单卡套餐内用量(A+B)、套餐外用量(C+D)均不整块搬运，拆开按池目标区域重判：&lt;b&gt;池内用量 += A + C&lt;/b&gt;；&lt;b&gt;当月池外用量 += B + D&lt;/b&gt;。B、C 为口径切换项。若并入 A+C 后池内用量突破池内总量：超量开关开 → 超出部分计入&lt;b&gt;当月超池用量&lt;/b&gt;；关 → 不产生超池，池内卡停机 suspend。该卡设备页字段同步切换为「当月区域内 / 区域外用量」口径。" vertex="1">
          <mxGeometry height="80" width="910" x="100" y="1150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-monthly" name="3 跨月刷新时序">
    <mxGraphModel dx="1297" dy="837" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1600" math="0" shadow="0">
